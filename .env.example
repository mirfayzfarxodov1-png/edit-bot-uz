# Edit Bot.uz - Environment Variables
# .env faylini .env.example dan nusxa oling va o'zgartiring

# Telegram Bot Token (BotFather dan oling)
# Secret sifatida TELEGRAM_BOT_TOKEN nomi bilan saqlanadi
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot Owner ID
OWNER_ID=5675087151

# Admin ID lar (vergul bilan ajratilgan)
ADMIN_IDS=5675087151,8404514882
